{
  "name": "r3f-interactive-flow-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm --filter r3f-interactive-flow build",
    "package:verify": "node scripts/verify-package-output.mjs",
    "package:smoke": "node scripts/verify-packed-package.mjs",
    "package:compat": "node scripts/verify-peer-compatibility.mjs",
    "typecheck": "pnpm --filter r3f-interactive-flow typecheck",
    "test": "pnpm --filter r3f-interactive-flow test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "pnpm build && pnpm package:verify && pnpm package:smoke && pnpm package:compat && pnpm typecheck && pnpm test && pnpm lint && pnpm format && pnpm --filter vite-basic build && pnpm pack:dry-run",
    "release": "pnpm release:check && changeset publish",
    "pack:dry-run": "pnpm --filter r3f-interactive-flow pack:dry-run",
    "consumer:published:verify": "node scripts/verify-published-package-consumer.mjs",
    "consumer:packed:vite:verify": "node scripts/verify-packed-vite-consumer.mjs",
    "consumer:packed:next:verify": "node scripts/verify-packed-next-consumer.mjs",
    "consumer:agent:verify": "node scripts/verify-agent-public-docs.mjs",
    "test:browser:input": "pnpm --dir packages/r3f-interactive-flow exec vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^10.7.0",
    "playwright": "1.61.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
